{
  "name": "hustlehub-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Real-browser Playwright tests for the HustleHub+ frontend and HTTPS API",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:evidence": "playwright test --config playwright.evidence.config.js",
    "install:browser": "playwright install --with-deps chromium",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
