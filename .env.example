# Private Compose configuration belongs in the ignored repository-root .env file.
MONGO_URI=
JWT_SECRET=

# The browser uses these host addresses; Docker service names are internal only.
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=https://localhost:4000

# Optional application configuration.
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# Optional Grafana Cloud log shipping; leave blank for local validation.
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
