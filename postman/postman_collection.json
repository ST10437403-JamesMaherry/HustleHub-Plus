        {
          "name": "15. Booking - Create Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client booking creates a matching simulated transaction', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  const expectedPrice = Number(pm.variables.get('expectedGigPrice'));",
                  "  pm.expect(json.message).to.eql('Booking confirmed and simulated transaction recorded');",
                  "  pm.expect(json.booking.gig).to.eql(pm.variables.get('gigId'));",
                  "  pm.expect(json.booking.client).to.eql(pm.variables.get('clientId'));",
                  "  pm.expect(json.booking.freelancer).to.eql(pm.variables.get('gigFreelancerId'));",
                  "  pm.expect(json.booking.amount).to.eql(expectedPrice);",
                  "  pm.expect(json.booking.status).to.eql('confirmed');",
                  "  pm.expect(json.transaction.booking).to.eql(json.booking.id);",
                  "  pm.expect(json.transaction.client).to.eql(pm.variables.get('clientId'));",
                  "  pm.expect(json.transaction.freelancer).to.eql(pm.variables.get('gigFreelancerId'));",
                  "  pm.expect(json.transaction.amount).to.eql(expectedPrice);",
                  "  pm.expect(json.transaction.status).to.eql('confirmed');",
                  "  pm.collectionVariables.set('bookingId', json.booking.id);",
                  "  pm.collectionVariables.set('transactionId', json.transaction.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
