{
  "info": {
    "_postman_id": "2932f6e6-7520-4c11-87ae-399cbac17e21",
    "name": "HustleHub+ Part 1 - Essential Tests",
    "description": "A concise Part 1 collection covering HTTPS, successful client and freelancer registration, required invalid registration scenarios, successful login with JWT capture, invalid login, and protected-route access.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:4000"
    },
    {
      "key": "password",
      "value": "Password123!"
    },
    {
      "key": "clientEmail",
      "value": ""
    },
    {
      "key": "freelancerEmail",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health and HTTPS",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString(36);",
              "pm.collectionVariables.set('clientEmail', `client.${runId}@example.com`);",
              "pm.collectionVariables.set('freelancerEmail', `freelancer.${runId}@example.com`);",
              "pm.collectionVariables.unset('clientId');",
              "pm.collectionVariables.unset('token');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health endpoint is available over HTTPS', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.variables.replaceIn(pm.request.url.toString())).to.match(/^https:\\/\\//i);",
              "  pm.expect(pm.response.json().protocol).to.eql('HTTPS');",
              "});",
              "pm.test('Important security headers are present', function () {",
              "  pm.expect(pm.response.headers.has('Content-Security-Policy')).to.be.true;",
              "  pm.expect(pm.response.headers.has('Strict-Transport-Security')).to.be.true;",
              "  pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "2. Register Client - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Client is registered safely', function () {",
              "  pm.response.to.have.status(201);",
              "  const json = pm.response.json();",
              "  pm.expect(json.user.email).to.eql(pm.variables.get('clientEmail'));",
              "  pm.expect(json.user.role).to.eql('client');",
              "  pm.expect(json.user).not.to.have.property('password');",
              "  pm.expect(json.user).not.to.have.property('passwordHash');",
              "  pm.collectionVariables.set('clientId', json.user.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Test Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"client\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "3. Register Freelancer - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Freelancer is registered safely', function () {",
              "  pm.response.to.have.status(201);",
              "  const json = pm.response.json();",
              "  pm.expect(json.user.email).to.eql(pm.variables.get('freelancerEmail'));",
              "  pm.expect(json.user.role).to.eql('freelancer');",
              "  pm.expect(json.user).not.to.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Test Freelancer\",\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"freelancer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "4. Register - Missing Field",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing registration field is rejected', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json()).to.have.property('error');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"missing-name@example.com\",\n  \"password\": \"{{password}}\",\n  \"role\": \"client\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "5. Register - Reject Admin Role",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Public admin registration is rejected', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error).to.eql('Role must be client or freelancer');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Test Admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "6. Register - Reject Malicious Name",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Script-like name is rejected safely', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json()).to.have.property('error');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"<script>alert(1)</script>\",\n  \"email\": \"malicious@example.com\",\n  \"password\": \"{{password}}\",\n  \"role\": \"client\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "7. Register - Duplicate Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate email is rejected', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().error).to.eql('An account with this email already exists');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Duplicate Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"client\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "8. Login - Success and Capture JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login returns a valid JWT', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.token).to.be.a('string').and.not.empty;",
              "  pm.expect(json.token.split('.')).to.have.lengthOf(3);",
              "  pm.expect(json.user.id).to.eql(pm.variables.get('clientId'));",
              "  pm.collectionVariables.set('token', json.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "9. Login - Invalid Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid login is rejected generically', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json()).to.eql({ error: 'Invalid credentials' });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "10. Current User - Valid JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Valid JWT grants access safely', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.user.id).to.eql(pm.variables.get('clientId'));",
              "  pm.expect(json.user.email).to.eql(pm.variables.get('clientEmail'));",
              "  pm.expect(json.user).not.to.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "11. Current User - Missing JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Protected route rejects missing JWT', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json()).to.eql({ error: 'Authentication required' });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      }
    }
  ]
}
