{
  "name": "hustlehub-api",
  "version": "1.0.0",
  "description": "Secure backend API for the HustleHub+ INSY7314 POE",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage', { recursive: true })\" && node --experimental-test-coverage --test-coverage-exclude=test/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test test/*.test.js",
    "test:api": "newman run ../postman/postman_collection.json -e ../postman/postman_environment.json --ssl-extra-ca-certs ./certs/localhost-cert.pem -r cli,junit --reporter-junit-export ../evidence/part2/newman/newman-report.xml",
    "test:security": "newman run ../postman/part3_security_collection.json -e ../postman/part3_security_environment.json --folder \"Security Matrix\" --ssl-extra-ca-certs ./certs/localhost-cert.pem -r cli,junit --reporter-junit-export ../evidence/part3/security-tests/security-matrix.xml",
    "test:security:limits": "newman run ../postman/part3_security_collection.json -e ../postman/part3_security_environment.json --folder \"Rate Limits\" --ssl-extra-ca-certs ./certs/localhost-cert.pem -r cli,junit --reporter-junit-export ../evidence/part3/security-tests/security-limits.xml"
  },
  "keywords": [
    "node",
    "express",
    "security",
    "insy7314"
  ],
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7"
  },
  "devDependencies": {
    "newman": "6.2.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
