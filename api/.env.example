PORT=4000
APP_NAME=HustleHubPlusAPI
NODE_ENV=development

CLIENT_ORIGIN=http://localhost:5173

USE_HTTPS=true
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost-cert.pem

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/hustlehub?appName=HustleHubPlus

BCRYPT_SALT_ROUNDS=12

JWT_SECRET=replace_with_your_local_secret
JWT_EXPIRES_IN=1h

# Optional Grafana Cloud log shipping; the token is a secret and must stay out of version control.
# GRAFANA_LOKI_URL=https://logs-prod-<region>.grafana.net
# GRAFANA_LOKI_USER=<numeric-user-id>
# GRAFANA_LOKI_TOKEN=<cloud-access-policy-token-with-logs-write>